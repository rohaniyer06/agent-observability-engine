# Copy to .env and adjust. Every value here has a working default in config.py,
# so an empty .env still runs against `make up`.

# ---- Infrastructure ----------------------------------------------------------
AOE_POSTGRES_DSN=postgresql://aoe:aoe@localhost:55432/aoe
AOE_REDIS_URL=redis://localhost:56379/0

# ---- Ingestion service -------------------------------------------------------
AOE_INGEST_HOST=0.0.0.0
AOE_INGEST_PORT=8000
# Reject a batch larger than this many spans (413).
AOE_MAX_BATCH_SPANS=500
# Reject a request body larger than this many bytes (413).
AOE_MAX_BODY_BYTES=1048576
# Backpressure: shed load with 503 + Retry-After once the stream is this deep.
AOE_BACKPRESSURE_STREAM_DEPTH=200000
# How often (ms) the ingest process refreshes its cached XLEN reading.
AOE_BACKPRESSURE_POLL_MS=250
# Approximate MAXLEN trim applied on XADD. Guards against unbounded Redis growth.
AOE_STREAM_MAXLEN=1000000
# Token bucket per client IP. 0 disables rate limiting.
AOE_RATE_LIMIT_RPS=0

# ---- Query API service -------------------------------------------------------
AOE_API_HOST=0.0.0.0
AOE_API_PORT=8001
AOE_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Worker pool -------------------------------------------------------------
AOE_WORKER_CONSUMER_GROUP=telemetry_workers
# Max spans pulled per XREADGROUP call.
AOE_WORKER_BATCH_SIZE=500
AOE_WORKER_BLOCK_MS=2000
# Reclaim entries stuck in another consumer's PEL for longer than this (ms).
AOE_WORKER_RECLAIM_IDLE_MS=30000
AOE_WORKER_RECLAIM_INTERVAL_MS=5000
# Trace finalization (see DEVIATIONS.md #2).
AOE_TRACE_IDLE_TIMEOUT_MS=5000
AOE_TRACE_END_GRACE_MS=500
AOE_FINALIZER_INTERVAL_MS=500
# Latency rollup flush cadence.
AOE_ROLLUP_FLUSH_INTERVAL_MS=5000
# Cost anomaly detection.
AOE_COST_WINDOW_SIZE=500
AOE_COST_MIN_SAMPLES=30
AOE_COST_WARN_ZSCORE=3.5
AOE_COST_CRITICAL_ZSCORE=6.0
# Path drift detection.
AOE_DRIFT_MIN_TRACES=50
AOE_DRIFT_BASELINE_FREQ_PCT=1.0
AOE_DRIFT_EVENT_COOLDOWN_MS=60000

# ---- Harness agent -----------------------------------------------------------
# Leave unset to run the deterministic simulated provider (no API calls, no cost).
# Set it to run the real LangGraph pipeline against the Anthropic API.
# ANTHROPIC_API_KEY=sk-ant-...
AOE_HARNESS_PROVIDER=auto          # auto | anthropic | simulated
AOE_HARNESS_MODEL=claude-haiku-4-5
AOE_HARNESS_MAX_TOKENS=512
AOE_INGEST_URL=http://localhost:8000
AOE_PIPELINE_NAME=support_ticket_triage
