# Copy to .env.local (git-ignored) to point the dashboard somewhere else.
#
# Base URL of the QUERY API (docs/API.md: port 8001). Both the REST endpoints
# and WS /v1/live are served from this one origin — see DEVIATIONS.md item 7.
# The WebSocket URL is derived from this value (http -> ws, https -> wss), so
# there is exactly one host to configure.
#
# Default when unset: http://localhost:8001
VITE_API_URL=http://localhost:8001
